# Copie para .env e ajuste conforme necessário. NUNCA commite .env real.

# PostgreSQL
POSTGRES_USER=worfair
POSTGRES_PASSWORD=worfair_dev_password
POSTGRES_DB=worfair
APP_DB_PASSWORD=worfair_app_dev_password
MIGRATOR_DB_PASSWORD=worfair_migrator_dev_password

# RabbitMQ
RABBITMQ_USER=worfair
RABBITMQ_PASSWORD=worfair_dev_password

# JWT (dev — chaves em dev/jwt/)
JWT_ISSUER=https://worfair.local
JWT_AUDIENCE=worfair-web

# Asaas (SANDBOX — nunca colocar chave de produção aqui)
ASAAS_BASE_URL=https://sandbox.asaas.com/api/v3
ASAAS_API_KEY=
# Token do webhook (mesmo valor cadastrado no painel Asaas → cobranca → webhook)
ASAAS_WEBHOOK_TOKEN=
# Wallet da plataforma para split automático da taxa (opcional)
ASAAS_SPLIT_WALLET_ID=

# Seed do SUPER_ADMIN inicial (criado SÓ se ainda não existir nenhum —
# o banco impõe 1 único via índice uq_single_super_admin).
# Defina, suba a API uma vez e REMOVA em seguida. O /register nunca cria admin.
AdminSeed__Email=
AdminSeed__Password=